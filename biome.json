{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["src/**", "*.json", "!bun.lock", "!src/services/web/client/routeTree.gen.ts"]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"rules": {
			"style": {
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"noLabelWithoutControl": {
					"level": "error",
					"options": {
						"inputComponents": ["Input", "Select", "Checkbox", "Range", "Switch"],
						"labelComponents": ["FieldLabel"]
					}
				}
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
