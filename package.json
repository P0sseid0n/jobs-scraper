{
	"name": "jobs-scraper",
	"type": "module",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "concurrently -n \"scraper,processing,storage,bot\" \"bun dev:scraper\" \"bun dev:processing\" \"bun dev:storage\" \"bun dev:bot\"",
		"dev:scraped": "concurrently -n \"processing,storage,bot\" \"bun dev:processing\" \"bun dev:storage\" \"bun dev:bot\"",
		"dev:scraper": "bun --watch src/services/scraper/index.ts",
		"dev:processing": "bun --watch src/services/post-processing/index.ts",
		"dev:storage": "bun --watch src/services/storage/index.ts",
		"dev:bot": "bun --watch src/services/discord-bot/index.ts",
		"start:scraper": "bun src/services/scraper/index.ts",
		"start:processing": "bun src/services/post-processing/index.ts",
		"start:storage": "bun src/services/storage/index.ts",
		"start:bot": "bun src/services/discord-bot/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"concurrently": "^10.0.5",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"amqplib": "^2.2.0",
		"discord.js": "^14.27.0",
		"jsonrepair": "^3.15.0",
		"mongoose": "^9.11.1",
		"ollama": "^0.6.4",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"puppeteer": "^25.12.0",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"zod": "^4.6.5"
	},
	"overrides": {
		"shell-quote": "^1.12.0"
	}
}
