{
	"name": "jobs-scraper",
	"type": "module",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "concurrently -n \"scraper,processing,bot,cv,web\" \"bun dev:scraper\" \"bun dev:processing\" \"bun dev:bot\" \"bun dev:cv\" \"bun dev:web\"",
		"dev:scraped": "concurrently -n \"processing,bot,cv,web\" \"bun dev:processing\" \"bun dev:bot\" \"bun dev:cv\" \"bun dev:web\"",
		"dev:scraper": "bun --watch src/services/scraper/index.ts",
		"dev:processing": "bun --watch src/services/post-processing/index.ts",
		"dev:bot": "bun --watch src/services/discord-bot/index.ts",
		"dev:cv": "bun --watch src/services/cv-updater/index.ts",
		"dev:web": "concurrently -k -n routes,web \"bun src/services/web/generate-routes.ts --watch\" \"bun --watch src/services/web/index.ts\"",
		"start:scraper": "bun src/services/scraper/index.ts",
		"start:processing": "bun src/services/post-processing/index.ts",
		"start:bot": "bun src/services/discord-bot/index.ts",
		"start:cv": "bun src/services/cv-updater/index.ts",
		"start:web": "NODE_ENV=production bun src/services/web/index.ts",
		"scraper:run": "bun src/services/scraper/request-run.ts",
		"scraper:verify": "bun src/services/scraper/submit-verification-code.ts",
		"db:migrate-jobs": "bun src/services/post-processing/migrate-job-fields.ts",
		"routes": "bun src/services/web/generate-routes.ts",
		"design-system": "bun src/services/web/design-system/make-previews.ts && bun src/services/web/design-system/build.ts && bun src/services/web/design-system/assemble.ts",
		"eval:extraction": "bun src/services/post-processing/eval-extraction.ts",
		"eval:export-fixtures": "bun src/services/post-processing/export-feedback-fixtures.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@tanstack/router-generator": "1.167.43",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/pngjs": "^6.0.5",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"concurrently": "^10.0.5",
		"prettier": "^3.9.9",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@tanstack/react-router": "1.169.2",
		"amqplib": "^2.2.0",
		"bun-plugin-tailwind": "^0.1.2",
		"discord.js": "^14.27.0",
		"franc-min": "^6.2.0",
		"jsonrepair": "^3.15.0",
		"jsqr": "^1.4.0",
		"mongoose": "^9.11.1",
		"ollama": "^0.6.4",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"pngjs": "^7.0.0",
		"puppeteer": "^25.12.0",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.1.14",
		"zod": "^4.6.5"
	},
	"overrides": {
		"shell-quote": "^1.12.0"
	}
}
