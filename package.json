{
	"name": "jobs-scraper",
	"type": "module",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "concurrently -n \"scraper,processing,storage,bot,cv\" \"bun dev:scraper\" \"bun dev:processing\" \"bun dev:storage\" \"bun dev:bot\" \"bun dev:cv\"",
		"dev:scraped": "concurrently -n \"processing,storage,bot,cv\" \"bun dev:processing\" \"bun dev:storage\" \"bun dev:bot\" \"bun dev:cv\"",
		"dev:scraper": "bun --watch src/services/scraper/index.ts",
		"dev:processing": "bun --watch src/services/post-processing/index.ts",
		"dev:storage": "bun --watch src/services/storage/index.ts",
		"dev:bot": "bun --watch src/services/discord-bot/index.ts",
		"dev:cv": "bun --watch src/services/cv-updater/index.ts",
		"start:scraper": "bun src/services/scraper/index.ts",
		"start:processing": "bun src/services/post-processing/index.ts",
		"start:storage": "bun src/services/storage/index.ts",
		"start:bot": "bun src/services/discord-bot/index.ts",
		"start:cv": "bun src/services/cv-updater/index.ts",
		"scraper:run": "bun src/services/scraper/request-run.ts",
		"scraper:verify": "bun src/services/scraper/submit-verification-code.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/pngjs": "^6.0.5",
		"@types/qrcode": "^1.5.6",
		"concurrently": "^10.0.5",
		"prettier": "^3.9.9",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"amqplib": "^2.2.0",
		"discord.js": "^14.27.0",
		"franc-min": "^6.2.0",
		"jsonrepair": "^3.15.0",
		"jsqr": "^1.4.0",
		"mongoose": "^9.11.1",
		"ollama": "^0.6.4",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"pngjs": "^7.0.0",
		"puppeteer": "^25.12.0",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"qrcode": "^1.5.4",
		"zod": "^4.6.5"
	},
	"overrides": {
		"shell-quote": "^1.12.0"
	}
}
