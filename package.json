{
	"name": "jobs",
	"main": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "concurrently -n \"scraper,processing,bot\" \"bun dev:scraper\" \"bun dev:processing\" \"bun dev:bot\"",
		"dev:scraped": "concurrently -n \"processing,storage,bot\" \"bun dev:processing\" \"bun dev:storage\" \"bun dev:bot\"",
		"dev:scraper": "bun --watch src/services/scraper/index.ts",
		"dev:processing": "bun --watch src/services/post-processing/index.ts",
		"dev:storage": "bun --watch src/services/storage/index.ts",
		"dev:bot": "bun --watch src/services/discord-bot/index.ts"
	},
	"keywords": [],
	"license": "ISC",
	"devDependencies": {
		"@types/amqplib": "^0.10.8",
		"@types/bun": "^1.3.3",
		"@types/node": "^24.10.1",
		"concurrently": "^9.2.1"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"amqplib": "^0.10.9",
		"discord.js": "^14.25.0",
		"jsonrepair": "^3.13.1",
		"mongoose": "^8.20.0",
		"ollama": "^0.6.3",
		"puppeteer": "^24.31.0",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2"
	}
}
