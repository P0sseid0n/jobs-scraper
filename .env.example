# ---------- Infraestrutura (docker-compose.yml) ----------
# Com GPU NVIDIA: descomente para todo `docker compose` usar a GPU no Ollama
# (separador ";" no Windows, ":" no Linux/macOS)
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
# Atenção: Mongo e RabbitMQ só criam o usuário na PRIMEIRA vez que o volume é criado.
# Se trocar as credenciais depois, recrie os volumes (docker compose down -v) ou altere o usuário manualmente.
RABBITMQ_USER=jobs
RABBITMQ_PASSWORD=troque-esta-senha
MONGO_USER=jobs
MONGO_PASSWORD=troque-esta-senha
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=troque-esta-senha

# ---------- Conexões usadas pelos serviços rodando na sua máquina ----------
# Se a senha tiver caracteres especiais (@, :, /, #...), use URL encoding nas URLs abaixo.
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672
MONGO_URL=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017/jobs?authSource=admin
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Confiança mínima (0-100) da IA para um post ser tratado como vaga
MIN_JOB_CONFIDENCE=60
# (valor inicial: depois vale o da coleção `settings`, como os da busca do scraper)

# ---------- Filas ----------
# Tentativas antes de mandar a mensagem para a fila <nome>.dlq, e atraso base do backoff exponencial
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000

# ---------- Scraper (LinkedIn) ----------
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# Opcional: valor do cookie li_at de uma sessão já logada (evita login/captcha)
LINKEDIN_LI_AT=
# Com HEADLESS=false você consegue resolver captcha/2FA manualmente na janela do navegador
HEADLESS=false
BROWSER_NO_SANDBOX=false
# Valores INICIAIS da busca: na primeira execução eles vão para a coleção `settings` do MongoDB
# e, a partir daí, valem os do banco (editáveis por outras fontes). Mudar aqui depois não tem efeito.
# Termos buscados nos posts do LinkedIn, separados por vírgula (cada um vira uma busca)
SEARCH_KEYWORDS=Front End Vue
# Filtro de data da busca: past-24h | past-week | past-month | any
SCRAPER_DATE_POSTED=past-24h
# Limite de posts por coleta, dividido entre os termos, para reduzir o risco de bloqueio da conta
SCRAPER_MAX_POSTS=50
# Tempo máximo (ms) esperando novos posts carregarem depois de rolar a página
SCRAPER_SCROLL_DELAY_MS=10000
# 0 = roda uma coleta e termina; N = fica rodando, coleta a cada N minutos e atende o "coletar agora"
SCRAPER_INTERVAL_MINUTES=0

# ---------- Discord ----------
DISCORD_TOKEN=
# Canal de texto (uma mensagem com embed por vaga) ou de fórum (um post por vaga, com as tags do fórum que baterem)
DISCORD_CHANNEL_ID=

# ---------- Currículo (cv-updater) ----------
# Executável do Tectonic (compilador LaTeX). No Docker já vem instalado.
TECTONIC_BIN=tectonic
# Opcionais (padrões abaixo):
# CV_TEX_FILE=data/cv/cv.tex
# CV_FONTS_DIR=src/services/cv-updater/assets/fonts
# CV_OUTPUT_DIR=data/cv/generated
# CV_MAX_PROJECTS=2

# Projetos do currículo escolhidos entre seus repositórios públicos do GitHub (opcional)
GITHUB_USERNAME=
# Opcional: sem token a API permite 60 requisições/hora (o cache é completado aos poucos)
GITHUB_TOKEN=
# Repositórios que nunca devem entrar no currículo, separados por vírgula
GITHUB_EXCLUDE_REPOS=
# GITHUB_CACHE_HOURS=24

# ---------- Logs ----------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_PRETTY=true
