# ---------- Infraestrutura (docker-compose.yml) ----------
# Com GPU NVIDIA: descomente para todo `docker compose` usar a GPU no Ollama
# (separador ";" no Windows, ":" no Linux/macOS)
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
# Atenção: Mongo e RabbitMQ só criam o usuário na PRIMEIRA vez que o volume é criado.
# Se trocar as credenciais depois, recrie os volumes (docker compose down -v) ou altere o usuário manualmente.
RABBITMQ_USER=jobs
RABBITMQ_PASSWORD=troque-esta-senha
MONGO_USER=jobs
MONGO_PASSWORD=troque-esta-senha
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=troque-esta-senha

# ---------- Conexões usadas pelos serviços rodando na sua máquina ----------
# Se a senha tiver caracteres especiais (@, :, /, #...), use URL encoding nas URLs abaixo.
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672
MONGO_URL=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017/jobs?authSource=admin
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ---------- Configurações (perfil, busca e filtros) ----------
# Todo serviço com banco lê estes valores ao subir, antes de qualquer outra coisa, e grava na coleção `settings`
# do MongoDB os que ainda não estão lá. Depois valem os do banco, editáveis pelo site: mudar aqui depois não tem
# efeito (para voltar a usar o .env, apague o documento, ex.: pelo mongo-express).
# Preenchidos aqui, aparecem já completos no onboarding (ou pule o onboarding com SKIP_ONBOARDING=true).
# Vazios: o onboarding do site sugere os da sua área.

# Perfil profissional: área (ex.: Enfermagem, Marketing) e cargo-alvo (ex.: Analista de Marketing Digital)
PROFILE_AREA=
PROFILE_TARGET_ROLE=
# Senioridade: intern | junior | mid | senior | lead (vazio = nenhuma)
PROFILE_SENIORITY=
# Idiomas em que você trabalha (ISO 639-1), separados por vírgula, ex.: pt,en
PROFILE_LANGUAGES=pt

# Termos buscados nos posts do LinkedIn, separados por vírgula (cada um vira uma busca).
# Sem nenhum termo, o scraper fica em espera, sem coletar
SEARCH_KEYWORDS=
# Filtro de data da busca: past-24h | past-week | past-month | any
SCRAPER_DATE_POSTED=past-24h
# Limite de posts por coleta, dividido entre os termos, para reduzir o risco de bloqueio da conta
SCRAPER_MAX_POSTS=50
# 0 = o scraper roda uma coleta e termina; N = fica rodando, coleta a cada N minutos e atende o "coletar agora"
SCRAPER_INTERVAL_MINUTES=0
# true = começa com as coletas automáticas pausadas ("coletar agora" continua funcionando)
SCRAPER_PAUSED=false

# Idiomas aceitos (ISO 639-1, detectados no texto do post) separados por vírgula, ex.: pt,en. Vazio aceita todos
JOB_LANGUAGES=pt
# Palavras que a vaga precisa citar (ao menos uma) no cargo ou nos conhecimentos, separadas por vírgula. Vazio desliga
JOB_REQUIRED_KEYWORDS=
# Palavras que descartam a vaga se aparecerem no cargo ou nos conhecimentos, separadas por vírgula. Vazio desliga
JOB_EXCLUDED_KEYWORDS=

# ---------- Filas ----------
# Tentativas antes de mandar a mensagem para a fila <nome>.dlq, e atraso base do backoff exponencial
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000

# ---------- Scraper (LinkedIn) ----------
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# Opcional: valor do cookie li_at de uma sessão já logada (evita login/captcha)
LINKEDIN_LI_AT=
# auto: sem janela; se o LinkedIn pedir verificação, QR code aparece no terminal, código vai por
#       `bun scraper:verify <código>` e captcha abre a janela (só onde há tela; no Docker salva um screenshot)
# true: nunca abre janela (Docker/servidor) | false: sempre com janela
HEADLESS=auto
BROWSER_NO_SANDBOX=false
# Tempo máximo (ms) esperando novos posts carregarem depois de rolar a página
SCRAPER_SCROLL_DELAY_MS=10000
# Pausa mínima (ms) depois de abrir o link de cada vaga de um post que lista várias (a pausa real fica entre 1x e 2x)
SCRAPER_LOOKUP_DELAY_MS=30000

# ---------- Discord ----------
DISCORD_TOKEN=
# Canal de texto (uma mensagem com embed por vaga) ou de fórum (um post por vaga, com as tags do fórum que baterem)
DISCORD_CHANNEL_ID=

# ---------- Site (web) ----------
# Endereço do site; sem login: deixe em 127.0.0.1 (no Docker o compose já publica a porta só em 127.0.0.1)
WEB_HOST=127.0.0.1
WEB_PORT=3000
# true = o site não abre o onboarding (configure tudo por este .env). false = abre enquanto falta o mínimo,
# com os campos já preenchidos pelo .env e editáveis
SKIP_ONBOARDING=false

# ---------- Currículo (cv-updater) ----------
# Executável do Tectonic (compilador LaTeX). No Docker já vem instalado.
TECTONIC_BIN=tectonic
# Opcionais (padrões abaixo):
# CV_TEX_FILE=data/cv/cv.tex
# CV_FONTS_DIR=src/services/cv-updater/assets/fonts
# CV_OUTPUT_DIR=data/cv/generated
# CV_MAX_PROJECTS=2

# Projetos do currículo escolhidos entre seus repositórios públicos do GitHub (opcional)
GITHUB_USERNAME=
# Opcional: sem token a API permite 60 requisições/hora (o cache é completado aos poucos)
GITHUB_TOKEN=
# Repositórios que nunca devem entrar no currículo, separados por vírgula
GITHUB_EXCLUDE_REPOS=
# GITHUB_CACHE_HOURS=24

# ---------- Logs ----------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_PRETTY=true
